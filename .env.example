# Copy this file to .env and adjust the values if needed.

# PostgreSQL started by docker-compose.yml
POSTGRES_USER=brume
# Use only URL-safe characters in the password (no #, /, ?, @ or :): docker-compose.yml puts it into a connection URL as is.
POSTGRES_PASSWORD=brume
POSTGRES_DB=brume
POSTGRES_PORT=5432

# Connection string used by Prisma and the API. Must match the POSTGRES_* values above.
DATABASE_URL=postgresql://brume:brume@localhost:5432/brume
