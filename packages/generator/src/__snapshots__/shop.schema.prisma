generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id      String   @id @default(uuid(7)) @db.Uuid
  email   String   @unique
  role    UserRole @default(CUSTOMER)
  profile Profile?
}

model Profile {
  id          String  @id @default(uuid(7)) @db.Uuid
  bio         String?
  preferences Json?
  user        User?   @relation(fields: [userId], references: [id])
  userId      String? @unique @db.Uuid
}

model Product {
  id         String        @id @default(uuid(7)) @db.Uuid
  name       String
  price      Float
  stock      Float         @default(0)
  status     ProductStatus @default(DRAFT)
  categories Category[]
}

model Category {
  id       String    @id @default(uuid(7)) @db.Uuid
  name     String    @unique
  products Product[]
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
