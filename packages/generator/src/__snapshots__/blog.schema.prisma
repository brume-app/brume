generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String @id @default(uuid(7)) @db.Uuid
  email String @unique
  name  String
}

model Post {
  id          String    @id @default(uuid(7)) @db.Uuid
  title       String
  content     String?
  published   Boolean   @default(false)
  publishedAt DateTime?
}

model Comment {
  id   String @id @default(uuid(7)) @db.Uuid
  body String
}
