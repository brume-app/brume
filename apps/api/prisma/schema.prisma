generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  document  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
